+def geometry_readout(b):
+    """readout() on the built geometry before it is rigged: the rest pose,
+    which is the bind pose, so the bmesh's own coordinates."""
+    bm = b.bm
+    idx = piece_indices(b)
+    pts = [x.co.copy() for x in bm.verts]
+    polys = [[x.index for x in f.verts] for f in bm.faces]
+    tree = BVHTree.FromPolygons(pts, polys)
+    poly_piece = {i: name for name, (vi, pi) in idx.items() for i in pi}
+    return readout(b, pts, idx, tree, poly_piece)
+
+
+def choose_gauge():
+    """Try GAUGE_CANDIDATES in order, building the geometry for each, and keep
+    the first whose readout passes every check: sets GAUGE_S and GAUGE_TURN.
+    Returns what was tried; raises if none passes (the task blocks)."""
+    global GAUGE_S, GAUGE_TURN
+    tried = []
+    geometry = Builder.STEPS[:Builder.STEPS.index("compass") + 1]
+    for s, turn in GAUGE_CANDIDATES:
+        GAUGE_S, GAUGE_TURN = s, turn
+        b = Builder()
+        for step in geometry:
+            getattr(b, step)()
+        problems, lm = geometry_readout(b)
+        tried.append({"gauge_s": s, "gauge_turn": turn, "problems": len(problems), "lcd": lm,
+                      "first_problems": problems[:3]})
+        b.bm.free()
+        if not problems:
+            return tried
+    raise RuntimeError("no gauge position passes the readout's checks:\n  " +
+                       "\n  ".join(json.dumps(t) for t in tried))
+
+
+def build_checked():
+    """The whole build at the first wrist height in WRIST_ZS where every clip
+    check passes, with the gauge chosen by choose_gauge() at each. Any rest
+    check failing raises at once. Returns (builder, problems, measurements,
+    clip problems, clip measurements)."""
+    global WRIST
+    wrist_tried = []
+    for z in WRIST_ZS:
+        WRIST = v(WRIST.x, WRIST.y, z)
+        gauge_tried = choose_gauge()
+        b = Builder()
+        b.build_all()
+        problems, m = check(b)
+        if problems:
+            raise RuntimeError(f"the arms fail their checks at wrist z {z}:\n  " + "\n  ".join(problems))
+        cp, cm = clip_checks(b)
+        wrist_tried.append({"wrist_z": z, "clip_problems": cp[:5]})
+        if not cp:
+            m["chosen"] = {"wrist_z": z, "gauge_s": GAUGE_S, "gauge_turn": GAUGE_TURN,
+                           "gauge_tried": [{k: t[k] for k in ("gauge_s", "gauge_turn", "problems", "lcd")}
+                                           for t in gauge_tried],
+                           "wrist_tried": wrist_tried}
+            return b, problems, m, cp, cm
+    raise RuntimeError("no wrist height passes the clip checks:\n  " +
+                       "\n  ".join(json.dumps(t) for t in wrist_tried))
+
+
